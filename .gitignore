# C1 native-4.4.0 cutover parity baselines (scratch; captured pre-conversion)
scripts/_parity_baselines/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Run-history side effects produced by interactive Shiny sessions. The files
# are local audit logs, never committed. Tests that exercise the success
# branch of _handle_result() guard against polluting this dir by patching
# osmose.history.RUN_HISTORY_DIR to a tmp_path (not via chdir).
data/history/
data/feedback/
# Calibration checkpoint/audit logs written by interactive runs — local only.
data/calibration_history/

# E2E screenshot outputs regenerated by the Playwright suite. Local proof
# artifacts, not committed (the curated 01-10 page screenshots ARE tracked).
screenshots/*_e2e.png

