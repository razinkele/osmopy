data/*/output/

# Visual-regression failure artifacts. Baselines under tests/visual_baselines/ ARE
# committed (do not add a tests/visual_* blanket glob).
tests/visual_output/

# Test preflight sentinel + lock — computed on demand (whichever test reaches
# tests/_ev_preflight.py::ensure_preflight_result first, guarded by a flock so
# concurrent pytest-xdist workers don't race) and cached for the FIE direction
# / genetics-activation tests. Must never be tracked; tracking it permanently
# bypasses the gate that protects those tests from running against a
# non-viable cod population (the cached payload is also stamped with
# PYTEST_XDIST_TESTRUNUID, so even a tracked file would only fool the ONE
# pytest invocation whose run id happened to match).
tests/.preflight_wired*

# Sphinx docs build output + generated autosummary stubs
docs/_build/
docs/api/_autosummary/

# Large generated test baselines (e.g. C3 Gate-A master fixture) — regenerate
# locally, never commit. Pre-existing curated baselines are already tracked
# and unaffected (gitignore does not untrack tracked files), but the bare
# *.npz/*.json rules below would still block `git add` on a FUTURE curated
# baseline without -f. Narrowed with the repo's own !-negation convention
# (see data/baltic/calibration_results/ above) so a new curated file only
# needs a line added here, not -f.
tests/baselines/*.npz
tests/baselines/*.json
!tests/baselines/benchmark_5yr_post_phase_a.json
!tests/baselines/benchmark_5yr_post_phase_b.json
!tests/baselines/benchmark_5yr_post_tier3.json
!tests/baselines/benchmark_5yr_pre_phase_a.json
!tests/baselines/benchmark_eec_5yr_post_scaling.json
!tests/baselines/benchmark_eec_5yr_pre_scaling.json
!tests/baselines/benchmark_post_tier1.json
!tests/baselines/benchmark_post_tier2.json
!tests/baselines/benchmark_post_tier3.json
!tests/baselines/benchmark_pre_tier1.json
!tests/baselines/parity_baseline_bob_1yr_seed42.npz
!tests/baselines/parity_baseline_eec_1yr_seed42.npz
!tests/baselines/statistical_baseline_bob_1yr_10seeds.npz
# Tiny gate series CSVs generated alongside reproduction_reference_seed3.npz
# (RV / thermal / recruitment-ceiling inputs; regenerated with the reference).
tests/baselines/reproduction_reference_files/
